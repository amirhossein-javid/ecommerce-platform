{
	admin 127.0.0.1:2019
}

# Internal-only BFF upstream. This listener is never published on the VPS.
# It lets Caddy be Django's single trusted proxy while preserving HTTPS-aware
# Django security behind container-to-container plain HTTP.
http://:8080 {
	reverse_proxy backend:8000 {
		header_up Host {$APP_DOMAIN}
		header_up X-Forwarded-Host {$APP_DOMAIN}
		header_up X-Forwarded-Proto https

		transport http {
			dial_timeout 3s
			response_header_timeout 60s
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=3600"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	route {
		handle_path /media/* {
			root * /srv/media
			file_server
		}

		@django {
			path /api/v1/payments/bale/webhook/ /api/v1/health/ /api/v1/health/readiness/ /admin /admin/* /static/*
		}

		handle @django {
			reverse_proxy backend:8000 {
				transport http {
					dial_timeout 3s
					response_header_timeout 30s
				}
			}
		}

		handle {
			reverse_proxy frontend:3000 {
				transport http {
					dial_timeout 3s
					response_header_timeout 60s
				}
			}
		}
	}
}
