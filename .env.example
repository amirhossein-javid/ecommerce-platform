# This file defaults to local development. Production must use the production
# settings module and replace every documented placeholder/test credential.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_JWT_SIGNING_KEY=replace-this-with-a-different-long-random-value
# Production only, optional during a controlled SECRET_KEY rotation.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Enable only when the TLS-terminating proxy strips and resets X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
# DRF throttling uses REMOTE_ADDR when this is 0. Set the exact trusted proxy
# count only when every ingress proxy sanitizes X-Forwarded-For.
DJANGO_THROTTLE_NUM_PROXIES=0
DJANGO_THROTTLE_AUTH_REGISTER_RATE=5/hour
DJANGO_THROTTLE_AUTH_LOGIN_RATE=10/minute
DJANGO_THROTTLE_AUTH_REFRESH_RATE=30/minute
DJANGO_THROTTLE_CART_MUTATION_RATE=60/minute
DJANGO_THROTTLE_CHECKOUT_RATE=10/minute
DJANGO_THROTTLE_PAYMENT_INITIATE_RATE=10/minute
DJANGO_THROTTLE_PAYMENT_VERIFY_RATE=20/minute
DJANGO_THROTTLE_BALE_WEBHOOK_RATE=300/minute
DJANGO_LOG_LEVEL=INFO
DJANGO_APP_LOG_LEVEL=INFO
# Production WSGI database connection reuse; use 0 to disable persistence.
DJANGO_DB_CONN_MAX_AGE=60

# Production container runtime. Tune concurrency after measuring the deployment.
PORT=8000
WEB_CONCURRENCY=1

# POSTGRES_* initializes the local Compose database only. Django and all
# production processes connect through DATABASE_URL.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
DATABASE_URL=postgresql://ecommerce:ecommerce@db:5432/ecommerce

# Server-only Django origin used by Next.js inside the Compose network.
DJANGO_API_URL=http://web:8000
# Browser-visible media origin used only to map local Compose media URLs.
DJANGO_PUBLIC_MEDIA_URL=http://localhost:8000/media/

PAYMENT_GATEWAY_CLASS=apps.payments.bale.BaleGateway
# Secret required when Bale is selected; inject it through the production
# environment or secret manager.
BALE_BOT_TOKEN=
# Public Bale wallet test token for development only; replace it in production.
BALE_PROVIDER_TOKEN=WALLET-TEST-1111111111111111
BALE_CONNECT_TIMEOUT=3.0
BALE_READ_TIMEOUT=10.0
# Set this to the public HTTPS /api/v1/payments/bale/webhook/ URL.
BALE_WEBHOOK_URL=
