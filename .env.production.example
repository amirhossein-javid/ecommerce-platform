# Copy this file to .env.production, set mode 600, and replace every
# REPLACE_WITH value before running the production stack.

# Public deployment identity. Use a hostname only, without a scheme or path.
APP_DOMAIN=REPLACE_WITH_PUBLIC_DOMAIN
# Immutable release identifier used to tag locally built application images.
APP_VERSION=REPLACE_WITH_RELEASE_ID

# PostgreSQL. Generate one URL-safe random password and use the same value in
# POSTGRES_PASSWORD and the password component of DATABASE_URL.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD
DATABASE_URL=postgresql://ecommerce:REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD@db:5432/ecommerce

# Django secrets must be distinct random values of at least 50 characters.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_DJANGO_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_JWT_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_JWT_KEY_AT_LEAST_50_CHARACTERS
DJANGO_SECRET_KEY_FALLBACKS=

DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_LOG_LEVEL=INFO
DJANGO_APP_LOG_LEVEL=INFO
WEB_CONCURRENCY=1

DJANGO_THROTTLE_AUTH_REGISTER_RATE=5/hour
DJANGO_THROTTLE_AUTH_LOGIN_RATE=10/minute
DJANGO_THROTTLE_AUTH_REFRESH_RATE=30/minute
DJANGO_THROTTLE_CART_MUTATION_RATE=60/minute
DJANGO_THROTTLE_CHECKOUT_RATE=10/minute
DJANGO_THROTTLE_PAYMENT_INITIATE_RATE=10/minute
DJANGO_THROTTLE_PAYMENT_VERIFY_RATE=20/minute
DJANGO_THROTTLE_BALE_WEBHOOK_RATE=300/minute
DJANGO_THROTTLE_REVIEW_MUTATION_RATE=10/hour

# Bale is the selected production gateway. The public webhook URL is derived
# from APP_DOMAIN by compose.production.yaml.
PAYMENT_GATEWAY_CLASS=apps.payments.bale.BaleGateway
BALE_BOT_TOKEN=REPLACE_WITH_BALE_BOT_TOKEN
BALE_PROVIDER_TOKEN=REPLACE_WITH_BALE_PRODUCTION_PROVIDER_TOKEN
BALE_CONNECT_TIMEOUT=3.0
BALE_READ_TIMEOUT=10.0

# Keep empty for Bale invoice identifiers. For a generic payment_url gateway,
# provide exact comma-separated HTTPS origins only.
PAYMENT_REDIRECT_ALLOWED_ORIGINS=
