# Used only when Next.js runs directly on the host. Compose overrides this with
# the Django service origin at http://web:8000.
DJANGO_API_URL=http://localhost:8000

# Browser-visible development origin for Django-uploaded media. External storage
# URLs returned by Django are not rewritten.
DJANGO_PUBLIC_MEDIA_URL=http://localhost:8000/media/

# Server-only exact origins accepted when Django returns a generic payment_url.
# Bale invoice identifiers do not use this allowlist.
PAYMENT_REDIRECT_ALLOWED_ORIGINS=
